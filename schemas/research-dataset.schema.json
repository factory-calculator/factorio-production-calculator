{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-calculator.github.io/factorio-production-calculator/schemas/research-dataset.schema.json",
  "title": "Factorio Production Calculator research dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "edition", "gameVersion", "provenance", "technologies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "edition": { "enum": ["base", "spaceage"] },
    "gameVersion": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?([+-][\\w.-]+)?$" },
    "provenance": {
      "type": "object",
      "required": ["sourceName", "sourceUrl", "retrievedAt", "permissionStatus"],
      "properties": {
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "retrievedAt": { "type": "string", "format": "date" },
        "permissionStatus": { "enum": ["pending", "approved", "test-fixture"] },
        "attribution": { "type": "string" },
        "permissionReference": { "type": "string" }
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "policyReview", "prerequisites"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": {
            "type": "object",
            "required": ["ja", "en", "zh-CN"],
            "properties": {
              "ja": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 },
              "zh-CN": { "type": "string", "minLength": 1 }
            }
          },
          "category": { "type": "string", "minLength": 1 },
          "policyReview": { "const": "approved" },
          "policyExcluded": { "type": "boolean" },
          "prerequisites": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "researchType": { "enum": ["science", "condition"] },
          "timeSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "unitCount": { "type": "number", "minimum": 0 },
          "countFormula": { "type": ["string", "null"] },
          "maxLevel": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "infinite" }] },
          "sciencePacks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "amountPerUnit"],
              "properties": {
                "id": { "type": "string" },
                "amountPerUnit": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          },
          "condition": {},
          "researchTrigger": {}
        }
      }
    }
  }
}
